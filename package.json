{
  "name": "arcgis-group-symbol-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "data:prepare": "python3 scripts/prepare-data.py",
    "data:refresh-admin": "python3 scripts/download-administration.py"
  },
  "dependencies": {
    "@arcgis/core": "~5.1.0",
    "@arcgis/map-components": "~5.1.0",
    "@esri/calcite-components": "~5.1.1"
  },
  "devDependencies": {
    "@types/node": "~24.10.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  }
}
